#!/usr/bin/env bash
# {{ ansible_managed }} — run by the webhook daemon as {{ webhook_user }}.
# Arguments come from the hook definition: a constant service name, then the commit SHA
# taken from the request payload (already matched against a SHA regex by the daemon, so a
# malformed one is a 403 and never reaches here).
set -euo pipefail

service="${1:?missing service}"
version="${2:?missing version}"

export ANSIBLE_CONFIG="{{ webhook_ansible_dir }}/ansible.cfg"
cd "{{ webhook_ansible_dir }}"

# Serialise deployments: the backend and ai pipelines can fire at the same time, and two
# concurrent compose runs on the same project fight over the same containers.
exec 9>"{{ webhook_lock_file }}"
if ! flock -w "{{ webhook_lock_timeout }}" 9; then
	echo "another deployment still holds the lock after {{ webhook_lock_timeout }}s, giving up" >&2
	exit 75
fi

echo "deploying ${service} at ${version}"
# exec keeps fd 9 open, so the lock is held for the whole playbook run and released when
# the process exits — however it exits.
exec ansible-playbook deploy.yml \
	-e "deploy_service=${service}" \
	-e "deploy_version=${version}"

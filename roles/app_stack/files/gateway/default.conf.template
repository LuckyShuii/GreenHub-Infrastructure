# Rendered by the nginx image's envsubst from BACKEND_UPSTREAM / AI_UPSTREAM.
# Upstreams go through variables + the Docker resolver so they resolve per-request
# (a service that is down doesn't stop the gateway from booting).

server {
    listen 80;
    server_name _;

    resolver 127.0.0.11 valid=10s ipv6=off;

    # The backend owns /api: the URI is forwarded untouched (proxy_pass with a
    # variable and no URI part), so its paths are the same with or without this
    # gateway -- a dev running only the backend repo's compose hits the same URLs.
    location /api/ {
        set $backend_upstream ${BACKEND_UPSTREAM};
        proxy_pass http://$backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # The AI service does not carry a prefix (it serves /greener/...), so unlike
    # /api the gateway strips /ai here.
    location /ai/ {
        set $ai_upstream ${AI_UPSTREAM};
        rewrite ^/ai/(.*)$ /$1 break;
        proxy_pass http://$ai_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /health {
        set $backend_upstream ${BACKEND_UPSTREAM};
        proxy_pass http://$backend_upstream/health;
    }
}

# {{ ansible_managed }} — rendered by the monitoring role, do not edit on the host.
# Secrets only; every non-secret Grafana setting lives in the compose file.
# 0600, and rendered with diff:false + no_log so the password never reaches Ansible output.
GF_SECURITY_ADMIN_USER={{ monitoring_grafana_admin_user }}
GF_SECURITY_ADMIN_PASSWORD={{ grafana_admin_password }}
{% if monitoring_alerting_enabled | bool %}
# Read back by the alerting provisioning file as ${{ monitoring_alert_webhook_env }}.
# Kept here rather than in the provisioning YAML so the secret stays in this 0600 file.
{{ monitoring_alert_webhook_env }}={{ discord_alert_webhook | trim }}
{% endif %}

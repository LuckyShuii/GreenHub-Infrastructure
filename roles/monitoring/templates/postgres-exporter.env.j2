# {{ ansible_managed }} — rendered by the monitoring role, do not edit on the host.
# 0600, rendered with diff:false + no_log: this file holds the database password.
#
# Its own file rather than the Grafana one, on purpose: the exporter has no business
# holding the Grafana admin password, and Grafana has none holding the database's.
#
# Encoding the password is not decoration — a DSN is a URL, so an unencoded `@`, `/` or
# `#` in it silently truncates the host or the database name, and the exporter then fails
# with an error pointing nowhere near the real cause.
#
# THE `replace` IS NOT REDUNDANT. Jinja's urlencode quotes with safe='/', so it escapes
# `@` and `#` and leaves `/` ALONE — verified on a rendered file, not assumed. A password
# containing a slash would sail through urlencode and cut the DSN in half.
{{ monitoring_pg_dsn_env }}=postgresql://{{ monitoring_pg_user }}:{{ db_password | urlencode | replace('/', '%2F') }}@{{ monitoring_pg_host }}:{{ monitoring_pg_port }}/{{ monitoring_pg_name }}?sslmode=disable

#!/usr/bin/env bash
# {{ ansible_managed }} — rendered by the monitoring role, do not edit on the host.
#
# TEMPORARY (SCRUM-87). No application is running on this host yet, so there is nothing to
# collect. This fabricates JSON lines shaped like what backend/ai/postgres/caddy will emit,
# purely so the chain file -> Alloy -> Loki -> Grafana can be proven end to end.
# SCRUM-129 deletes this script, its timer and its log directory.
set -euo pipefail

dir="{{ monitoring_sample_log_dir }}"
max_lines={{ monitoring_sample_max_lines }}

services=({% for s in monitoring_sample_services %}"{{ s }}" {% endfor %})
levels=({% for l in monitoring_sample_levels %}"{{ l }}" {% endfor %})
messages=({% for m in monitoring_sample_messages %}"{{ m }}" {% endfor %})

# Lengths come from Ansible, not from bash: the array-length syntax starts with a dollar,
# a brace and a hash, and that brace-hash pair opens a Jinja comment in this template.
n_levels={{ monitoring_sample_levels | length }}
n_messages={{ monitoring_sample_messages | length }}

for svc in "${services[@]}"; do
  file="$dir/$svc.log"
  # A handful of lines per tick: enough to see movement in Grafana, not enough to matter.
  for _ in $(seq 1 $((RANDOM % 5 + 1))); do
    printf '{"ts":"%s","level":"%s","service":"%s","msg":"%s","duration_ms":%s}\n' \
      "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      "${levels[$((RANDOM % n_levels))]}" \
      "$svc" \
      "${messages[$((RANDOM % n_messages))]}" \
      "$((RANDOM % 900 + 5))" \
      >>"$file"
  done

  # Self-trimming: a throwaway source does not deserve a logrotate rule. Truncate in place
  # so Alloy keeps following the same inode instead of re-reading a brand new file.
  if [ "$(wc -l <"$file")" -gt "$max_lines" ]; then
    trimmed="$(tail -n "$max_lines" "$file")"
    printf '%s\n' "$trimmed" >"$file"
  fi
done

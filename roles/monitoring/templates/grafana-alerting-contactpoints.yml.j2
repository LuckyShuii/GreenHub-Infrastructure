# {{ ansible_managed }} — rendered by the monitoring role, do not edit on the host.
#
# Contains NO secret. Grafana interpolates $VAR inside provisioning files, so the webhook
# URL is read from {{ monitoring_env_file }} (0600) at load time, and this file stays 0644
# and fully visible in --check --diff.
#
# TWO contact points, ONE webhook, ONE channel. The split is not about where the message
# lands — it is about whether it pings. See the critical receiver below for why that
# cannot be done with a single one.
apiVersion: 1

contactPoints:
  - orgId: {{ monitoring_grafana_org_id }}
    name: {{ monitoring_alert_contact_point }}
    receivers:
      - uid: {{ monitoring_alert_contact_point }}
        type: discord
        # false on purpose: Grafana then also sends a RESOLVED message. A channel that only
        # ever fires tells you an incident started but never that it ended.
        disableResolveMessage: false
        settings:
          url: ${{ monitoring_alert_webhook_env }}

          # THE setting that makes the rest of this file possible. Grafana's Discord
          # notifier normally puts `message` in the payload's top-level `content` and leaves
          # the embed with a title only. Discord does NOT render masked links —
          # [word](url) — in `content`; it renders them in an embed description. So without
          # this flag the links below would arrive as raw URLs, three lines of noise.
          #
          # THE COST, and it is a real one: Discord only delivers @mention notifications
          # from `content`. With the message inside the embed, an `@here` or `<@id>` added
          # to the template below would render as text and ping nobody, silently. That is
          # precisely why the critical receiver below exists and turns this OFF.
          use_embed_description: true

          # The values below are GO templates for Grafana, not Jinja: wrapped in raw so
          # Ansible ships them verbatim.
          #
          # The embed already carries the status as a COLOUR (red firing, green resolved)
          # and links its title to the alert list, so spelling out "[FIRING]" would repeat
          # what the reader can already see. The emoji separates the three cases the colour
          # alone cannot: resolved, firing-warning, firing-critical.
          title: >-
            {% raw %}{{ if eq .Status "firing" }}{{ if eq .CommonLabels.severity "critical"
            }}🔴{{ else }}🟠{{ end }}{{ else }}✅{{ end }} {{ .CommonLabels.alertname }}{% endraw %}

          # Three lines, deliberately: what happened, where, what to open. This REPLACES
          # `default.message`, which dumps every label and annotation of every alert plus
          # two bare URLs — accurate, unreadable, and mostly a repeat of the title.
          #
          # `summary` is ranged over rather than read from .CommonAnnotations: an annotation
          # only lands in CommonAnnotations when it is identical across the whole group, so
          # the moment a rule templates a measured value into its summary the common one
          # goes empty and the message would lose its only sentence.
          #
          # And it is shown only while FIRING. A summary is written in the present tense
          # about a problem — "ne tourne plus depuis 5m" — so repeating it on the resolved
          # message states something that has just stopped being true. The title still names
          # what recovered, which is the part worth keeping.
          #
          # The notification policy groups on (alertname, env, service), so a group holds
          # one alert in practice and .CommonLabels is safe for the context line.
          #
          # The raw block is interrupted once, on the logs link, to let Jinja insert the
          # dashboard base URL. It is NOT built from Grafana's `.ExternalURL`: that value
          # carries a trailing slash and produced `//d/greener-logs/` in a captured payload.
          #
          # `silence` only appears while firing — offering to silence an alert that just
          # resolved is noise — and `logs` is skipped for the host rules, which have no
          # log stream of their own.
          message: |-
            {% raw %}{{ if eq .Status "firing" }}{{ range .Alerts }}{{ .Annotations.summary }}
            {{ end }}{{ else }}Retour à la normale.
            {{ end }}`{{ .CommonLabels.env }}` · `{{ .CommonLabels.service }}` · `{{ .CommonLabels.severity }}`
            {{ range .Alerts }}[règle]({{ .GeneratorURL }}){{ if eq .Status "firing" }} · [silence]({{ .SilenceURL }}){{ end }}{{ if ne .Labels.service "host" }} · [logs]({% endraw %}{{ monitoring_alert_logs_link_base }}{% raw %}/d/greener-logs/?var-service={{ .Labels.service }}&from=now-1h&to=now){{ end }}
            {{ end }}{% endraw %}

  # --- The critical door ------------------------------------------------------------------
  # Same webhook, same channel, same title template. One difference, and it is forced on us
  # by Grafana rather than chosen: this receiver must PING, and a ping only works from the
  # payload's top-level `content`.
  #
  # Read receivers/discord/v1/discord.go in grafana/alerting:
  #
  #     if d.settings.UseEmbedDescription {
  #         msg.Content = ""
  #     } else {
  #         msg.Content = messageContent
  #     }
  #
  # `content` is emptied OUTRIGHT when the message moves into the embed. There is no
  # template trick that puts a mention in one and the body in the other — the two are
  # mutually exclusive per contact point, which is why this is a second contact point and
  # not a second template.
  #
  # WHAT SURVIVES: the embed is still attached (Grafana always sends one), so the coloured
  # red title is unchanged. WHAT IS LOST: masked links. `[règle](url)` in `content` renders
  # as literal text, so the links below are bare URLs — and there are two, not three.
  # Silencing is one click away from the rule page, and a third long URL on a 03:00 page is
  # cost without benefit.
  - orgId: {{ monitoring_grafana_org_id }}
    name: {{ monitoring_alert_contact_point_critical }}
    receivers:
      - uid: {{ monitoring_alert_contact_point_critical }}
        type: discord
        disableResolveMessage: false
        settings:
          url: ${{ monitoring_alert_webhook_env }}
          use_embed_description: false

          title: >-
            {% raw %}{{ if eq .Status "firing" }}🔴{{ else }}✅{{ end }} {{ .CommonLabels.alertname }}{% endraw %}

          # The mention is FIRING-ONLY. Being pinged to be told something recovered is how a
          # channel gets muted, which would defeat the entire purpose of this receiver.
{% if monitoring_alert_critical_mention | length > 0 %}
          message: |-
            {% raw %}{{ if eq .Status "firing" }}{% endraw %}{{ monitoring_alert_critical_mention }}{% raw %}
            {{ range .Alerts }}{{ .Annotations.summary }}
            {{ end }}{{ else }}Retour à la normale.
            {{ end }}`{{ .CommonLabels.env }}` · `{{ .CommonLabels.service }}` · `{{ .CommonLabels.severity }}`
            {{ range .Alerts }}Règle : {{ .GeneratorURL }}{{ if ne .Labels.service "host" }}
            Logs : {% endraw %}{{ monitoring_alert_logs_link_base }}{% raw %}/d/greener-logs/?var-service={{ .Labels.service }}&from=now-1h&to=now{{ end }}
            {{ end }}{% endraw %}
{% else %}
          # monitoring_alert_critical_mention is empty: the route still exists (and still
          # escapes the night mute), it simply pings nobody.
          message: |-
            {% raw %}{{ if eq .Status "firing" }}{{ range .Alerts }}{{ .Annotations.summary }}
            {{ end }}{{ else }}Retour à la normale.
            {{ end }}`{{ .CommonLabels.env }}` · `{{ .CommonLabels.service }}` · `{{ .CommonLabels.severity }}`
            {{ range .Alerts }}Règle : {{ .GeneratorURL }}
            {{ end }}{% endraw %}
{% endif %}

// {{ ansible_managed }} — rendered by the monitoring role, do not edit on the host.
// Two REAL sources, no synthetic files any more (SCRUM-129):
//   * the containers of the `{{ monitoring_app_compose_project }}` compose project, read
//     through the Docker API;
//   * the systemd journal, for the services that run natively and have no container.
// Both pipelines converge on the SAME label set (service, level, env, source, agent), so a
// single dashboard query covers a containerised and a native service alike.
//
// Since SCRUM-99 this file also produces METRICS: the node and cAdvisor exporters run
// inside Alloy and remote-write to Prometheus. See the metrics section at the bottom.

logging {
  level  = "info"
  format = "logfmt"
}

// --- Source 1: the application containers -------------------------------------------------

discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "{{ monitoring_docker_refresh_interval }}"
}

discovery.relabel "app_containers" {
  targets = discovery.docker.containers.targets

  // An ALLOW-list on the compose project, not a deny-list. This host also runs containers
  // that have nothing to do with GREENER, and the monitoring stack's own containers must
  // not ship their logs into the Loki those logs are about — Alloy reporting a push error
  // by pushing it is a loop. A keep rule stays correct the day somebody starts one more
  // unrelated container; enumerating what to exclude would not.
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = "{{ monitoring_app_compose_project }}"
    action        = "keep"
  }

  // The compose service name IS the service label: backend, ai, postgres, qdrant, gateway.
  // The journal pipeline below produces the same shape for the native services.
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

// Reads over the Docker API, NOT over the network: the daemon hands the log stream to
// Alloy, which is why this collector still has no reason to join greener_internal.
loki.source.docker "app" {
  host             = "unix:///var/run/docker.sock"
  targets          = discovery.relabel.app_containers.output
  forward_to       = [loki.process.app.receiver]
  refresh_interval = "{{ monitoring_docker_refresh_interval }}"
}

// --- Source 2: the systemd journal --------------------------------------------------------

discovery.relabel "journal_units" {
  // No targets: this component exists only to hand its RULES to loki.source.journal, which
  // applies them to the metadata of every journal entry.
  targets = []

  // Same allow-list reasoning as the containers: the journal of a public-facing VPS is
  // mostly sshd refusing internet scans, and none of it is application logs.
  rule {
    source_labels = ["__journal__systemd_unit"]
    // Backticks, not quotes: Alloy strings follow Go's escape rules, where `\.` is not a
    // valid escape — a raw string hands the regex straight to the matcher.
    regex         = `{{ monitoring_journal_units | map('replace', '.', '\\.') | join('|') }}`
    action        = "keep"
  }

  // caddy.service -> caddy, so a native service reads like a compose service.
  rule {
    source_labels = ["__journal__systemd_unit"]
    regex         = "(.+)\\.service"
    target_label  = "service"
    replacement   = "$1"
  }
}

loki.source.journal "host" {
  path          = "/var/log/journal"
  // Bounds a first run (and a run after Alloy was down) to something sane instead of
  // replaying the whole persistent journal.
  max_age       = "{{ monitoring_journal_max_age }}"
  relabel_rules = discovery.relabel.journal_units.rules
  forward_to    = [loki.process.journal.receiver]
}

// --- Pipeline: containers -----------------------------------------------------------------
//
// NO stage.timestamp anywhere, deliberately. The synthetic generator emitted one known
// format; five real services emit five, none of them the same, one of them (the AI service)
// carrying no timezone at all. A mis-parsed timestamp does not fail loudly — it silently
// files logs at the wrong time, or trips Loki's reject_old_samples and drops them. Docker
// and the journal both stamp every line themselves, within milliseconds of the event, and
// that stamp cannot be malformed. The application's own timestamp stays in the line.
loki.process "app" {
  forward_to = [loki.write.default.receiver]

  stage.static_labels {
    values = {
      env    = "{{ env_name }}",
      agent  = "alloy",
      source = "docker",
    }
  }

{% if monitoring_drop_healthcheck_logs | bool %}
  // The backend probes itself every 10 s (the compose healthcheck) and uvicorn logs every
  // single probe: ~8 600 lines a day that only say "the probe ran". Anchored on the
  // loopback client so a real /health call from outside is still collected. Dropped first
  // so it costs neither an index entry nor disk.
  stage.match {
    selector = `{service="backend"}`

    stage.drop {
      expression          = `^INFO: +127\.0\.0\.1:[0-9]+ - "GET /health HTTP/1\.1" 200`
      drop_counter_reason = "backend_healthcheck"
    }
  }
{% endif %}

  // --- Levels ---------------------------------------------------------------------------
  // Levels are assigned by matching the line, not by extracting a field, because there is
  // no field to extract: uvicorn writes `INFO:`, the AI service `[INFO]`, Postgres `LOG:`,
  // Qdrant a bare `INFO`, nginx `[error]` or nothing at all. Matching keeps each service's
  // own vocabulary in one readable place and cannot half-fail the way a regex whose format
  // drifted does — it just stops upgrading the level.
  //
  // Everything starts at info and the stages below run in ASCENDING severity, so a later
  // match overrides an earlier one and a line is labelled with the worst thing it says
  // about itself. A line always ends up with a level: a stream with no `level` label is
  // invisible to every dashboard and rule that filters on it.
  //
  // Every selector is an Alloy RAW string (backticks) holding a LogQL query whose line
  // filter is double-quoted. That is not a style choice: the LogQL parser inside the match
  // stage rejects backtick strings of its own, and an Alloy double-quoted selector would
  // need every backslash doubled twice over. Raw string outside, LogQL escaping inside,
  // one level of `\\` — and `alloy fmt` accepts the wrong version too, so a change here is
  // only proven by running it (see the README).
  stage.static_labels {
    values = { level = "info" }
  }

  // Python logging (backend, ai) and the Qdrant tracing format, all anchored so the word
  // "debug" inside a URL or a message does not relabel the line.
  stage.match {
    selector = `{service=~"backend|ai"} |~ "^(DEBUG|TRACE):|\\[(DEBUG|TRACE)\\]"`

    stage.static_labels {
      values = { level = "debug" }
    }
  }

  stage.match {
    selector = `{service="qdrant"} |~ "Z +(DEBUG|TRACE) "`

    stage.static_labels {
      values = { level = "debug" }
    }
  }

  stage.match {
    selector = `{service=~"backend|ai"} |~ "^WARNING:|\\[WARNING\\]"`

    stage.static_labels {
      values = { level = "warn" }
    }
  }

  stage.match {
    selector = `{service="qdrant"} |~ "Z +WARN "`

    stage.static_labels {
      values = { level = "warn" }
    }
  }

  // Postgres prefixes with the process id: `... UTC [27] WARNING:`.
  stage.match {
    selector = `{service="postgres"} |~ "\\] WARNING:"`

    stage.static_labels {
      values = { level = "warn" }
    }
  }

  // nginx writes its access log and its error_log to the same stream, so the gateway is
  // read twice: once for the level it declares, once for the status it served. An access
  // line has no level of its own — the status code is the only thing it says about itself,
  // and a 5xx is an error whatever nginx logged it as.
  stage.match {
    selector = `{service="gateway"} |~ "\\[(warn|notice)\\]|\" 4[0-9][0-9] "`

    stage.static_labels {
      values = { level = "warn" }
    }
  }

  stage.match {
    selector = `{service=~"backend|ai"} |~ "^(ERROR|CRITICAL):|\\[(ERROR|CRITICAL)\\]"`

    stage.static_labels {
      values = { level = "error" }
    }
  }

  stage.match {
    selector = `{service="qdrant"} |~ "Z +ERROR "`

    stage.static_labels {
      values = { level = "error" }
    }
  }

  // ERROR, FATAL and PANIC are the three Postgres levels that mean something went wrong;
  // LOG, NOTICE, DETAIL and HINT are not levels in that sense and stay info.
  stage.match {
    selector = `{service="postgres"} |~ "\\] (ERROR|FATAL|PANIC):"`

    stage.static_labels {
      values = { level = "error" }
    }
  }

  stage.match {
    selector = `{service="gateway"} |~ "\\[(error|crit|alert|emerg)\\]|\" 5[0-9][0-9] "`

    stage.static_labels {
      values = { level = "error" }
    }
  }
}

// --- Pipeline: journal --------------------------------------------------------------------

loki.process "journal" {
  forward_to = [loki.write.default.receiver]

  stage.static_labels {
    values = {
      env    = "{{ env_name }}",
      agent  = "alloy",
      source = "journal",
      level  = "info",
    }
  }

  // Caddy logs structured JSON, so its level is quoted verbatim in the line. Matching it as
  // text rather than parsing the JSON keeps this pipeline uniform with the container one,
  // and Caddy's `msg`/`logger` fields stay queryable with `| json` in Grafana.
  stage.match {
    selector = `{service="caddy"} |~ "\"level\":\"debug\""`

    stage.static_labels {
      values = { level = "debug" }
    }
  }

  stage.match {
    selector = `{service="caddy"} |~ "\"level\":\"warn\""`

    stage.static_labels {
      values = { level = "warn" }
    }
  }

  stage.match {
    selector = `{service="caddy"} |~ "\"level\":\"(error|fatal|panic)\""`

    stage.static_labels {
      values = { level = "error" }
    }
  }

  // The CD webhook's log IS the Ansible output of the deploy it just ran, so its levels are
  // Ansible's own vocabulary: a `fatal:` line or a non-zero `failed=` in the recap means the
  // deploy broke, which is exactly what should show up as an error on the dashboard.
  stage.match {
    selector = `{service="{{ monitoring_webhook_service }}"} |~ "^fatal:|\\bfailed=[1-9]"`

    stage.static_labels {
      values = { level = "error" }
    }
  }

  // The Docker daemon's own level prefix, e.g. `level=error msg="..."`.
  stage.match {
    selector = `{service="docker"} |~ "level=warning"`

    stage.static_labels {
      values = { level = "warn" }
    }
  }

  stage.match {
    selector = `{service="docker"} |~ "level=(error|fatal)"`

    stage.static_labels {
      values = { level = "error" }
    }
  }
}

loki.write "default" {
  endpoint {
    url = "http://loki:{{ monitoring_loki_port }}/loki/api/v1/push"
  }
}

// --- Metrics (SCRUM-99) -------------------------------------------------------------------
//
// The exporters run INSIDE Alloy rather than as their own containers. node_exporter and
// cAdvisor both need what this collector already has — root, the host's /proc and /sys, and
// the Docker socket — so a separate cAdvisor container would have to be `privileged` to
// obtain privileges Alloy holds anyway. One agent, one set of host mounts, one thing to
// reason about. Prometheus is then only a store: it scrapes nothing but itself.

prometheus.exporter.unix "host" {
  // Host paths, not the container's own: without these the metrics describe the collector.
  // See the compose file for the matching mounts.
  rootfs_path = "{{ monitoring_host_rootfs_mount }}"
  procfs_path = "{{ monitoring_host_procfs_mount }}"
  sysfs_path  = "{{ monitoring_host_sysfs_mount }}"

  // Container health, written on the host by the greener-container-health timer. cAdvisor
  // exports container_health_state but samples it once per container and never refreshes
  // it, so it reports "starting" for ever on anything a deploy recreated.
  textfile {
    directory = "{{ monitoring_host_rootfs_mount }}{{ monitoring_container_health_dir }}"
  }
}

prometheus.exporter.cadvisor "containers" {
  docker_host = "unix:///var/run/docker.sock"

  // Only Docker containers, not every cgroup on the host: systemd's own slices would
  // otherwise double every number under a second set of series.
  docker_only = true

  // CARDINALITY. store_container_labels exports EVERY Docker label as a metric label, and
  // compose sets several — including the config hash, which changes on every deploy and
  // would orphan a whole set of series each time. The allow-list keeps the two that
  // identify a container and nothing else.
  store_container_labels       = false
  allowlisted_container_labels = ["com.docker.compose.project", "com.docker.compose.service"]
}

prometheus.scrape "infra" {
  targets = concat(
    prometheus.exporter.unix.host.targets,
    prometheus.exporter.cadvisor.containers.targets,
  )
  forward_to      = [prometheus.relabel.infra.receiver]
  scrape_interval = "{{ monitoring_prometheus_scrape_interval }}"
}

prometheus.relabel "infra" {
  forward_to = [prometheus.remote_write.default.receiver]

  // Same env label the logs carry, so one dashboard variable covers both.
  rule {
    target_label = "env"
    replacement  = "{{ env_name }}"
  }

  // And the same `service` label as the logs: a container's compose service name. This is
  // what lets a dashboard put a service's CPU next to its error rate without a join.
  rule {
    source_labels = ["container_label_com_docker_compose_service"]
    regex         = "(.+)"
    target_label  = "service"
  }

  // The long label has done its job; dropping it halves the label set on every container
  // series. `service` and `project` below carry the same information.
  rule {
    source_labels = ["container_label_com_docker_compose_project"]
    regex         = "(.+)"
    target_label  = "project"
  }

  rule {
    regex  = "container_label_com_docker_compose_.*"
    action = "labeldrop"
  }
}

prometheus.remote_write "default" {
  endpoint {
    url = "http://prometheus:{{ monitoring_prometheus_port }}/api/v1/write"
  }
}
{% if monitoring_blackbox_enabled | bool %}

// --- Blackbox probes: the certificate nobody else watches ---------------------------------
//
// Runs inside Alloy like the other exporters, for the same reason: one agent, one set of
// mounts, one thing to reason about.
//
// WHY AT ALL, given UptimeRobot already probes these URLs: UptimeRobot answers "is the
// site up", which a probe running ON the VPS cannot honestly answer about itself. What
// this adds is the number nobody else has — `probe_ssl_earliest_cert_expiry`. Caddy
// exports no certificate-expiry metric, so fetching the certificate is the only way to see
// an ACME renewal that has been failing quietly for a week.
//
// The probes leave the host and come back through the PUBLIC name, deliberately: that is
// the certificate a browser is really served, chain and SNI included, rather than whatever
// sits in Caddy's storage directory.
prometheus.exporter.blackbox "external" {
  // Inline YAML rather than a config_file: one module, and a second bind-mounted file for
  // four lines would be a file to keep in sync for no benefit.
  config = "{ modules: { {{ monitoring_blackbox_module }}: { prober: http, timeout: {{ monitoring_blackbox_timeout }} } } }"

{% for target in monitoring_blackbox_targets %}
  target {
    name    = "{{ target.name }}"
    address = "{{ target.address }}"
    module  = "{{ monitoring_blackbox_module }}"
  }
{% endfor %}
}

// Its own scrape, at its own interval: a probe opens a real TLS connection to a real
// endpoint, so running it every {{ monitoring_prometheus_scrape_interval }} like the local exporters would be four
// needless handshakes a minute for a value that changes once every three months.
prometheus.scrape "blackbox" {
  targets         = prometheus.exporter.blackbox.external.targets
  forward_to      = [prometheus.relabel.infra.receiver]
  scrape_interval = "{{ monitoring_blackbox_scrape_interval }}"
}
{% endif %}
{% if monitoring_postgres_exporter_enabled | bool %}

// --- PostgreSQL ---------------------------------------------------------------------------
// The exporter is a container on this network (see the compose file), so this is an
// ordinary scrape by service name. It is the one component that also joins the
// application network — the reasoning for that is in defaults/main.yml.
prometheus.scrape "postgres" {
  targets = [
    {"__address__" = "postgres_exporter:{{ monitoring_postgres_exporter_port }}", "job" = "integrations/postgres"},
  ]
  forward_to      = [prometheus.relabel.infra.receiver]
  scrape_interval = "{{ monitoring_prometheus_scrape_interval }}"
}
{% endif %}

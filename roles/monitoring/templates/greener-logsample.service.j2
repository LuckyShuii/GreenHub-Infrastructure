# {{ ansible_managed }} — rendered by the monitoring role, do not edit on the host.
[Unit]
Description=GREENER synthetic log generator (temporary, SCRUM-87)
Documentation=https://greener-epitech.atlassian.net/browse/SCRUM-87

[Service]
Type=oneshot
ExecStart={{ monitoring_sample_script }}
# Writes only under its own log directory; nothing else on the host is reachable.
ProtectSystem=strict
ReadWritePaths={{ monitoring_sample_log_dir }}
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true

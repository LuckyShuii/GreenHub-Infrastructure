# {{ ansible_managed }} — rendered by the monitoring role, do not edit on the host.
#
# Alert rules are code: provisioned by file, so a rule edited in the UI does not survive a
# restart. Build a rule in the UI if that is easier, then export it in provisioning format
# and commit it here — the UI is a drafting tool, this file is the truth.
#
# Two groups: what the services SAY (Loki) and what they DO (Prometheus). The second group
# is what finally answers "is this container alive" — SCRUM-99.
apiVersion: 1

groups:
  - orgId: {{ monitoring_grafana_org_id }}
    name: greener-logs
    folder: {{ monitoring_alert_rules_folder }}
    interval: {{ monitoring_alert_rules_interval }}
    rules:
      # --- Too many errors ---------------------------------------------------------------
      # One alert instance per service, because the query groups by service: Grafana turns
      # each returned series into its own instance, and our notification policy groups on
      # (alertname, env, service).
      - uid: greener-error-rate
        title: Taux d'erreurs anormal
        condition: B
        data:
          - refId: A
            relativeTimeRange:
              from: {{ monitoring_alert_error_range }}
              to: 0
            datasourceUid: loki
            model:
              refId: A
              datasource:
                type: loki
                uid: loki
              # instant, not range: alerting wants one value per series, not a curve.
              queryType: instant
              expr: 'sum by (service, env) (count_over_time({env="{{ env_name }}", level="error"} [{{ monitoring_alert_error_window }}]))'
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            relativeTimeRange:
              from: {{ monitoring_alert_error_range }}
              to: 0
            datasourceUid: __expr__
            model:
              refId: B
              type: threshold
              expression: A
              datasource:
                type: __expr__
                uid: __expr__
              conditions:
                - evaluator:
                    type: gt
                    params: [{{ monitoring_alert_error_threshold }}]
              intervalMs: 1000
              maxDataPoints: 43200
        # No error lines at all means nothing is wrong, so silence must NOT alert here.
        noDataState: OK
        execErrState: Error
        for: {{ monitoring_alert_error_for }}
        labels:
          severity: warning
        annotations:
          summary: >-
            {% raw %}{{ printf "%.0f" $values.A.Value }}{% endraw %} erreurs en
            {{ monitoring_alert_error_window }} sur ce service
            (seuil {{ monitoring_alert_error_threshold }}).
        isPaused: false
{% if monitoring_alert_silence_enabled | bool %}
{% for svc in monitoring_alert_watched_services %}

      # --- {{ svc }} has gone quiet ------------------------------------------------------
      # Deliberately one rule PER SERVICE. A dead service stops producing a stream, so it
      # disappears from an aggregated result rather than reporting zero — a single rule
      # covering every service would never see one of them die. Here the disappearance
      # becomes NoData on a rule that names {{ svc }}, and noDataState raises it.
      - uid: greener-silent-{{ svc }}
        title: Service {{ svc }} muet
        condition: B
        data:
          - refId: A
            relativeTimeRange:
              from: {{ monitoring_alert_silence_range }}
              to: 0
            datasourceUid: loki
            model:
              refId: A
              datasource:
                type: loki
                uid: loki
              queryType: instant
              expr: 'sum(count_over_time({env="{{ env_name }}", service="{{ svc }}"} [{{ monitoring_alert_silence_window }}]))'
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            relativeTimeRange:
              from: {{ monitoring_alert_silence_range }}
              to: 0
            datasourceUid: __expr__
            model:
              refId: B
              type: threshold
              expression: A
              datasource:
                type: __expr__
                uid: __expr__
              # Catches a service still holding a stream but writing nothing. The total
              # disappearance case is handled by noDataState below.
              conditions:
                - evaluator:
                    type: lt
                    params: [1]
              intervalMs: 1000
              maxDataPoints: 43200
        # THE point of this rule: silence is the symptom, so NoData must alert.
        noDataState: Alerting
        execErrState: Alerting
        for: {{ monitoring_alert_silence_for }}
        # Static labels, not query labels: on NoData the query returns no series and
        # carries no labels, so without these the Discord message could not say WHICH
        # service went quiet, and the notification policy could not group on it.
        labels:
          service: {{ svc }}
          env: {{ env_name }}
          severity: critical
        annotations:
          summary: >-
            Aucun log de {{ svc }} depuis {{ monitoring_alert_silence_window }} —
            le service est probablement arrêté.
        isPaused: false
{% endfor %}
{% endif %}

{% if monitoring_alert_metrics_rules_enabled | bool %}

  # --- Metrics (SCRUM-99) ---------------------------------------------------------------
  - orgId: {{ monitoring_grafana_org_id }}
    name: greener-metrics
    folder: {{ monitoring_alert_rules_folder }}
    interval: {{ monitoring_alert_rules_interval }}
    rules:
      # --- Disk filling up -------------------------------------------------------------
      # The tightest constraint on this host, and the one the log pipeline itself can
      # threaten. execErrState: Alerting is doing real work here — if Prometheus cannot be
      # queried at all the rule errors, and a monitoring stack that has stopped answering
      # is exactly as urgent as the disk it can no longer measure.
      - uid: greener-disk-low
        title: Disque presque plein
        condition: B
        data:
          - refId: A
            relativeTimeRange:
              from: {{ monitoring_alert_metrics_range }}
              to: 0
            datasourceUid: prometheus
            model:
              refId: A
              datasource:
                type: prometheus
                uid: prometheus
              instant: true
              range: false
              expr: '100 * (1 - node_filesystem_avail_bytes{mountpoint="/",fstype!~"tmpfs|devtmpfs|overlay|squashfs|ramfs|fuse.*"} / node_filesystem_size_bytes{mountpoint="/",fstype!~"tmpfs|devtmpfs|overlay|squashfs|ramfs|fuse.*"})'
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            relativeTimeRange:
              from: {{ monitoring_alert_metrics_range }}
              to: 0
            datasourceUid: __expr__
            model:
              refId: B
              type: threshold
              expression: A
              datasource:
                type: __expr__
                uid: __expr__
              conditions:
                - evaluator:
                    type: gt
                    params: [{{ monitoring_alert_disk_threshold }}]
              intervalMs: 1000
              maxDataPoints: 43200
        noDataState: OK
        execErrState: Alerting
        for: {{ monitoring_alert_disk_for }}
        labels:
          env: {{ env_name }}
          service: host
          severity: critical
        # One sentence. This annotation IS the Discord message body (see the contact
        # point), so what to do about it belongs in the README, not in every alert.
        #
        # `$values.A.Value` is the number query A returned FOR THIS INSTANCE — the reason
        # the contact point ranges over .Alerts instead of reading .CommonAnnotations: the
        # moment a summary carries a measured value it stops being identical across the
        # group, and a common annotation would go empty.
        annotations:
          summary: >-
            {% raw %}Le disque racine est à {{ printf "%.1f" $values.A.Value }} %{% endraw %}
            d'occupation (seuil {{ monitoring_alert_disk_threshold }} %).
        isPaused: false

      # --- Memory ------------------------------------------------------------------------
      # MemAvailable, not MemFree: the page cache is reclaimable, and counting it as used
      # would keep this rule firing on a perfectly healthy machine.
      - uid: greener-memory-high
        title: Mémoire presque saturée
        condition: B
        data:
          - refId: A
            relativeTimeRange:
              from: {{ monitoring_alert_metrics_range }}
              to: 0
            datasourceUid: prometheus
            model:
              refId: A
              datasource:
                type: prometheus
                uid: prometheus
              instant: true
              range: false
              expr: '100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)'
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            relativeTimeRange:
              from: {{ monitoring_alert_metrics_range }}
              to: 0
            datasourceUid: __expr__
            model:
              refId: B
              type: threshold
              expression: A
              datasource:
                type: __expr__
                uid: __expr__
              conditions:
                - evaluator:
                    type: gt
                    params: [{{ monitoring_alert_memory_threshold }}]
              intervalMs: 1000
              maxDataPoints: 43200
        noDataState: OK
        execErrState: Alerting
        for: {{ monitoring_alert_memory_for }}
        labels:
          env: {{ env_name }}
          service: host
          severity: warning
        annotations:
          summary: >-
            {% raw %}{{ printf "%.1f" $values.A.Value }} %{% endraw %} de la RAM occupée,
            hors cache réclamable (seuil {{ monitoring_alert_memory_threshold }} %).
        isPaused: false
{% for svc in monitoring_alert_expected_containers %}

      # --- {{ svc }} is not running -----------------------------------------------------
      # THE rule the log-based silence rules pretended to be. cAdvisor emits series for a
      # container as long as it RUNS, whatever it logs, so absence is death and not a quiet
      # night. One rule per service for the same reason as before: a missing series cannot
      # be grouped over.
      #
      # READ THE STATES BACKWARDS HERE. absent() returns 1 when the series is MISSING and
      # nothing at all when it is present — so the healthy case is NoData, which is why
      # noDataState is OK. It is the opposite of the log rules it replaces.
      - uid: greener-container-down-{{ svc }}
        title: Conteneur {{ svc }} arrêté
        condition: B
        data:
          - refId: A
            relativeTimeRange:
              from: {{ monitoring_alert_metrics_range }}
              to: 0
            datasourceUid: prometheus
            model:
              refId: A
              datasource:
                type: prometheus
                uid: prometheus
              instant: true
              range: false
              expr: 'absent(container_last_seen{project="{{ monitoring_app_compose_project }}", service="{{ svc }}"})'
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            relativeTimeRange:
              from: {{ monitoring_alert_metrics_range }}
              to: 0
            datasourceUid: __expr__
            model:
              refId: B
              type: threshold
              expression: A
              datasource:
                type: __expr__
                uid: __expr__
              conditions:
                - evaluator:
                    type: gt
                    params: [0]
              intervalMs: 1000
              maxDataPoints: 43200
        noDataState: OK
        execErrState: Alerting
        for: {{ monitoring_alert_container_down_for }}
        # Static, like the log silence rules: absent() returns a series with NO labels, so
        # without these the message could not name the service that died.
        labels:
          env: {{ env_name }}
          service: {{ svc }}
          severity: critical
        annotations:
          summary: >-
            Le conteneur {{ svc }} ne tourne plus depuis
            {{ monitoring_alert_container_down_for }}.
        isPaused: false
{% endfor %}

      # --- Restart loop ------------------------------------------------------------------
      # The gap every other rule leaves open. A container that dies and comes back every
      # minute is `running` most of the time, so greener-container-down-* never fills its
      # 5 min `for`, and the external probe (SCRUM-90) sees a facade answering between two
      # deaths. Nobody is told.
      #
      # ONE rule for every service, unlike the down rules, and for the opposite reason:
      # here the series EXISTS — the container is running — so `by (service)` returns one
      # instance per service, and a missing series is not what we are looking for.
      #
      # A deploy does not trip this. A compose recreate gives the container a new id, so
      # cAdvisor opens a fresh series whose start time has never changed; only a restart in
      # place moves the value of an existing series, which is exactly what a crash loop is.
      - uid: greener-restart-loop
        title: Boucle de redémarrage
        condition: B
        data:
          - refId: A
            relativeTimeRange:
              from: {{ monitoring_alert_metrics_range }}
              to: 0
            datasourceUid: prometheus
            model:
              refId: A
              datasource:
                type: prometheus
                uid: prometheus
              instant: true
              range: false
              expr: >-
                max by (service, env) (changes(container_start_time_seconds{project="{{
                monitoring_app_compose_project }}"}[{{ monitoring_alert_restart_window }}]))
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            relativeTimeRange:
              from: {{ monitoring_alert_metrics_range }}
              to: 0
            datasourceUid: __expr__
            model:
              refId: B
              type: threshold
              expression: A
              datasource:
                type: __expr__
                uid: __expr__
              conditions:
                - evaluator:
                    type: gt
                    params: [{{ monitoring_alert_restart_threshold }}]
              intervalMs: 1000
              maxDataPoints: 43200
        noDataState: OK
        execErrState: Alerting
        for: {{ monitoring_alert_restart_for }}
        # No static service label here, unlike every rule above: this query RETURNS one, and
        # a static label would flatten every service onto a single alert instance.
        labels:
          severity: critical
        annotations:
          summary: >-
            {% raw %}{{ printf "%.0f" $values.A.Value }}{% endraw %} démarrages en
            {{ monitoring_alert_restart_window }}
            (seuil {{ monitoring_alert_restart_threshold }}).
        isPaused: false
{% for svc, grace in monitoring_alert_healthcheck_grace.items() %}

      # --- {{ svc }} fails its healthcheck ------------------------------------------------
      # Finer than "is it running": a container can run while failing its own probe.
      #
      # READ THE THRESHOLD CAREFULLY. cAdvisor encodes container_health_state as 1 healthy,
      # 0 starting OR unhealthy, -1 no healthcheck declared — so the window is centred on 0
      # and must EXCLUDE -1, which means "nobody is checking" rather than "it is broken".
      # Hence within_range and not a plain `lt 1`.
      #
      # `for: {{ grace }}` is not a round number picked for comfort: "starting" also reads as 0, so
      # it has to outlast {{ svc }}'s start_period in app_stack — 20 minutes for the AI service,
      # which indexes every region before it answers.
      - uid: greener-unhealthy-{{ svc }}
        title: Healthcheck {{ svc }} en échec
        condition: B
        data:
          - refId: A
            relativeTimeRange:
              from: {{ monitoring_alert_metrics_range }}
              to: 0
            datasourceUid: prometheus
            model:
              refId: A
              datasource:
                type: prometheus
                uid: prometheus
              instant: true
              range: false
              # Aggregated, though a single container answers: the raw series drags `id`,
              # `image` and `name` along, and `id` changes on every recreate — each deploy
              # would mint a brand new alert instance. It also makes a recreate err towards
              # silence, the fresh container reading 0 while the old one still reads 1.
              expr: >-
                max by (service, env) (container_health_state{project="{{
                monitoring_app_compose_project }}", service="{{ svc }}"})
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            relativeTimeRange:
              from: {{ monitoring_alert_metrics_range }}
              to: 0
            datasourceUid: __expr__
            model:
              refId: B
              type: threshold
              expression: A
              datasource:
                type: __expr__
                uid: __expr__
              conditions:
                - evaluator:
                    type: within_range
                    params: [-0.5, 0.5]
              intervalMs: 1000
              maxDataPoints: 43200
        # A container that has disappeared produces no series at all, and that case belongs
        # to greener-container-down-{{ svc }}. Silence is not this rule's business.
        noDataState: OK
        execErrState: Alerting
        for: {{ grace }}
        labels:
          env: {{ env_name }}
          service: {{ svc }}
          severity: critical
        annotations:
          summary: >-
            Le conteneur {{ svc }} tourne mais échoue son healthcheck depuis {{ grace }}.
        isPaused: false
{% endfor %}
{% endif %}

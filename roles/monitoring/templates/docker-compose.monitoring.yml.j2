# {{ ansible_managed }} — rendered by the monitoring role, do not edit on the host.
# The Grafana admin password comes from {{ monitoring_env_file }} (0600): no secret here.
services:
  loki:
    image: {{ monitoring_loki_image }}
    restart: unless-stopped
    command: ["-config.file=/etc/loki/config.yml"]
    volumes:
      - {{ monitoring_config_dir }}/loki.yml:/etc/loki/config.yml:ro
      - {{ monitoring_loki_data_volume }}:/loki
    # Never published: only Alloy (push) and Grafana (query) talk to it, both on this network.
    expose:
      - "{{ monitoring_loki_port }}"
    networks:
      - {{ monitoring_network }}
    # No healthcheck: the image is distroless — no shell, no wget, no curl, so there is
    # nothing in it to probe /ready with. Readiness is verified from Ansible instead, and
    # end to end: it asks Grafana to run a real query against this datasource.

  alloy:
    image: {{ monitoring_alloy_image }}
    restart: unless-stopped
    depends_on:
      loki:
        condition: service_started
      prometheus:
        condition: service_started
    # Root, and it has to be: both real sources are root-owned on the host — the Docker API
    # socket (root:docker) and the persistent journal (root:systemd-journal). See the
    # README for what that costs and what would remove the need.
    user: root
    # THE setting that makes container metrics work on this kernel. Docker gives a container
    # a PRIVATE cgroup namespace by default on cgroup v2, in which the container sees only
    # its own cgroup as `/` — cAdvisor then reports one series for itself and nothing for
    # the other containers, silently. Verified: without this, `container_cpu_usage_seconds_total`
    # comes back with `id="/"` alone.
    cgroup: host
    command:
      - run
      - /etc/alloy/config.alloy
      - --storage.path=/var/lib/alloy/data
      - --server.http.listen-addr=0.0.0.0:{{ monitoring_alloy_port }}
    volumes:
      - {{ monitoring_config_dir }}/config.alloy:/etc/alloy/config.alloy:ro
      # The Docker API: how the container logs are read. Note this is NOT a network path —
      # the daemon hands over the log stream — which is why alloy stays off greener_internal.
      # `:ro` protects the socket FILE, not the API behind it (see the README).
      - /var/run/docker.sock:/var/run/docker.sock:ro
      # The persistent journal, for the services that run natively (Caddy, the CD webhook,
      # the Docker daemon). machine-id is how sd-journal finds this host's journal directory;
      # without it the journal reads as empty and nothing fails.
      - /var/log/journal:/var/log/journal:ro
      - /etc/machine-id:/etc/machine-id:ro
      # --- Metrics (SCRUM-99): the host as node_exporter and cAdvisor need to see it ------
      # Without these the exporters describe the COLLECTOR, not the machine: /proc and /sys
      # are separate mounts, so bind-mounting / alone would hand over an empty /host/proc.
      - /proc:{{ monitoring_host_procfs_mount }}:ro
      - /sys:{{ monitoring_host_sysfs_mount }}:ro
      # cAdvisor reads container filesystem stats from the graph driver.
      - /var/lib/docker:/var/lib/docker:ro
      # And containerd's socket, which `cgroup: host` above does NOT make up for: the two
      # failures look identical from the dashboards and have nothing to do with each other.
      # Docker here uses the containerd snapshotter (storage driver `overlayfs`), so for
      # every container it discovers cAdvisor asks containerd for the layers. Without this
      # mount that call fails, cAdvisor drops the container it had just found — logging
      # "unable to create containerd client for overlayfs storage driver" once per container
      # per scrape — and exports one lonely series for the root cgroup. Every container
      # panel is then empty and absent() declares the whole stack dead while it runs.
      - {{ monitoring_containerd_socket }}:{{ monitoring_containerd_socket }}:ro
      # rslave, and it matters: a plain bind of / does NOT carry its submounts, so the
      # filesystem collector would report one line for / and miss every other mount.
      - type: bind
        source: /
        target: {{ monitoring_host_rootfs_mount }}
        read_only: true
        bind:
          propagation: rslave
      # Holds the read offsets (positions), so a restart does not re-ship everything.
      - {{ monitoring_alloy_data_volume }}:/var/lib/alloy/data
    expose:
      - "{{ monitoring_alloy_port }}"
    networks:
      - {{ monitoring_network }}
    # No healthcheck: the image ships neither curl nor wget, and unlike qdrant it has no
    # bash either, so there is nothing to probe /-/ready with. `docker compose ps` and the
    # Alloy UI (port {{ monitoring_alloy_port }}, over the SSH tunnel) are the way to check it.

  # A STORE, not a collector: Alloy runs the exporters and remote-writes the series in, so
  # this scrapes nothing but itself. Never published — only Grafana queries it.
  prometheus:
    image: {{ monitoring_prometheus_image }}
    restart: unless-stopped
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time={{ monitoring_prometheus_retention }}
      # Without this the remote-write endpoint answers 404 and Alloy retries for ever.
      - --web.enable-remote-write-receiver
      - --web.listen-address=0.0.0.0:{{ monitoring_prometheus_port }}
      # No admin API: nothing here needs to delete series over HTTP, and it is the one
      # endpoint that can destroy the data.
    volumes:
      - {{ monitoring_config_dir }}/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - {{ monitoring_prometheus_data_volume }}:/prometheus
    expose:
      - "{{ monitoring_prometheus_port }}"
    networks:
      - {{ monitoring_network }}
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O- http://127.0.0.1:{{ monitoring_prometheus_port }}/-/healthy | grep -qi healthy"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 30s

  grafana:
    image: {{ monitoring_grafana_image }}
    restart: unless-stopped
    depends_on:
      loki:
        condition: service_started
      prometheus:
        condition: service_started
    env_file:
      - {{ monitoring_env_file }}
    environment:
      # Provisioned from files below; nobody signs up, nobody phones home.
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_ANALYTICS_REPORTING_ENABLED: "false"
      GF_ANALYTICS_CHECK_FOR_UPDATES: "false"
{% if grafana_public | default(false) | bool %}
      GF_SERVER_ROOT_URL: "{{ monitoring_grafana_root_url }}"
      # Compensating controls for as long as this instance answers from the internet
      # (SCRUM-133). Conditional on purpose: behind the VPN they would be noise, and their
      # presence is the signal that the exposure is still on.
      # Caddy already redirects HTTP to HTTPS, so marking the session cookie Secure costs
      # nothing and closes the downgrade case.
      GF_SECURITY_COOKIE_SECURE: "true"
      # No outbound request per avatar. The accounts use synthetic @greener.local
      # addresses, so nothing real would leak either way — this just stops the egress.
      GF_SECURITY_DISABLE_GRAVATAR: "true"
      # Grafana defaults to 30 days, which is a long time for a stolen session on a
      # publicly reachable instance.
      GF_AUTH_LOGIN_MAXIMUM_LIFETIME_DURATION: "{{ monitoring_grafana_session_lifetime }}"
{% endif %}
    volumes:
      - {{ monitoring_grafana_provisioning_dir }}:/etc/grafana/provisioning:ro
      - {{ monitoring_grafana_dashboards_dir }}:/var/lib/grafana/dashboards:ro
      - {{ monitoring_grafana_data_volume }}:/var/lib/grafana
    # Loopback only — Caddy stays the single host-facing service. Reach it with
    #   ssh -L {{ monitoring_grafana_port }}:{{ monitoring_grafana_publish }} <user>@<vps>
    ports:
      - "{{ monitoring_grafana_publish }}:{{ monitoring_grafana_port }}"
    networks:
      - {{ monitoring_network }}
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O- http://127.0.0.1:{{ monitoring_grafana_port }}/api/health | grep -q ok"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 30s

volumes:
  {{ monitoring_loki_data_volume }}:
  {{ monitoring_alloy_data_volume }}:
  {{ monitoring_grafana_data_volume }}:
  {{ monitoring_prometheus_data_volume }}:

networks:
  {{ monitoring_network }}:
    driver: bridge

    {
      "type": "row",
      "title": "Journal lisible",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      }
    },
    {
      "type": "table",
      "title": "Authentifications — qui, quand, accepté ou refusé",
      "description": "Un événement d'authentification par ligne, le plus récent en haut. La colonne Méthode est vide sur un refus survenu avant que le client ne propose une clé (utilisateur inconnu, abandon pré-auth). Toutes les colonnes sont filtrables par l'icône d'en-tête.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service=\"ssh\", source=\"journal\"} |~ \"Accepted |Failed |Invalid user |Connection closed by (authenticating|invalid) user|Disconnected from authenticating user\" | regexp \"(?P<evt>Accepted|Failed|Invalid user|Connection closed by authenticating user|Connection closed by invalid user|Disconnected from authenticating user)\" | regexp \"(?:(?P<methode>publickey|password|keyboard-interactive) )?(?:for|user) (?P<user>[^ ]+) (?:from )?(?P<ip>[0-9.]+)\" | label_format statut=`{{ if eq .evt \"Accepted\" }}Accepté{{ else }}Refusé{{ end }}`"
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "json",
            "replace": false,
            "keepTime": false
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "Time",
                "user",
                "methode",
                "statut",
                "ip"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "includeByName": {},
            "indexByName": {
              "Time": 0,
              "user": 1,
              "methode": 2,
              "statut": 3,
              "ip": 4
            },
            "renameByName": {
              "user": "Utilisateur",
              "methode": "Méthode",
              "statut": "Statut",
              "ip": "Source",
              "Time": "Heure"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ]
        },
        "sortBy": [
          {
            "displayName": "Heure",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true,
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Heure"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 165
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Statut"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "custom.width",
                "value": 110
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Accepté": {
                        "color": "green",
                        "index": 0,
                        "text": "Accepté"
                      },
                      "Refusé": {
                        "color": "red",
                        "index": 1,
                        "text": "Refusé"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "type": "table",
      "title": "Sessions — ouvertures et fermetures",
      "description": "Le cycle de vie des sessions, tel que PAM le rapporte. À distinguer de l'authentification : une authentification acceptée ouvre une session, et sa fermeture est la déconnexion. Une ouverture sans fermeture correspondante signifie une session encore active.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service=\"ssh\", source=\"journal\"} |~ \"session (opened|closed) for user\" | regexp \"session (?P<evt>opened|closed) for user (?P<user>[^( ]+)\" | label_format statut=`{{ if eq .evt \"opened\" }}Ouverture{{ else }}Fermeture{{ end }}`"
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "json",
            "replace": false,
            "keepTime": false
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "Time",
                "user",
                "statut"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "includeByName": {},
            "indexByName": {
              "Time": 0,
              "user": 1,
              "statut": 2
            },
            "renameByName": {
              "user": "Utilisateur",
              "statut": "Statut",
              "Time": "Heure"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ]
        },
        "sortBy": [
          {
            "displayName": "Heure",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true,
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Heure"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 165
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Statut"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "custom.width",
                "value": 110
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Ouverture": {
                        "color": "green",
                        "index": 0,
                        "text": "Ouverture"
                      },
                      "Fermeture": {
                        "color": "blue",
                        "index": 1,
                        "text": "Fermeture"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {

        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum (count_over_time({service=\"ssh\", source=\"journal\"} |~ \"Connection closed by (authenticating|invalid) user|Disconnected from authenticating user\" [$__auto]))",
          "legendFormat": "abandon avant authentification"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum (count_over_time({service=\"ssh\", source=\"journal\"} |~ \"Failed (password|publickey)\" [$__auto]))",

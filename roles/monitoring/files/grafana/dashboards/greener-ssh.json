{
  "uid": "greener-ssh",
  "title": "GREENER — Accès SSH",
  "description": "Connexions SSH des membres de l'équipe : qui se connecte, depuis quelle adresse VPN, et ce qui a été refusé. Source : journal systemd de ssh.service, collecté par Alloy.",
  "tags": [
    "greener",
    "ssh",
    "securite",
    "logs"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "name": "Annotations & Alerts",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "search",
        "label": "Recherche",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0,
        "description": "Filtre plein texte sur le journal complet (insensible à la casse)."
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Vue d'ensemble",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Connexions acceptées",
      "description": "Authentifications réussies sur la plage affichée. SSH n'étant joignable que par le VPN, chaque ligne est un membre de l'équipe.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum (count_over_time({service=\"ssh\", source=\"journal\"} |= \"Accepted \" [$__auto]))",
          "legendFormat": "v"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Tentatives refusées",
      "description": "Clé refusée, utilisateur inconnu, ou abandon avant authentification.",

          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "count (sum by (ip) (count_over_time({service=\"ssh\", source=\"journal\"} |= \"Accepted \" | pattern `Accepted <method> for <user> from <ip> port <_>` [$__auto])))",
          "legendFormat": "v"
        }
      ],
      "options": {
        "reduceOptions": {

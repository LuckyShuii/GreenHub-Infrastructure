    {
      "type": "timeseries",
      "title": "Refus, par motif",
      "description": "Un utilisateur inconnu est une faute de frappe ou un scan ; une clé refusée est un membre dont la clé n'est pas, ou plus, dans users.yml. Les deux derniers motifs restent souvent à zéro — c'est normal.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 27
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum (count_over_time({service=\"ssh\", source=\"journal\"} |~ \"Invalid user\" [$__auto]))",
          "legendFormat": "utilisateur inconnu"

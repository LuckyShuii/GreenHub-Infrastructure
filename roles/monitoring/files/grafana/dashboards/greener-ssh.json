    {
      "type": "stat",
      "title": "Adresses sources distinctes",
      "description": "Doit rester dans 10.8.0.0/24 : une adresse publique signifierait que SSH est joignable hors du tunnel.",
      "datasource": {
        "type": "loki",
        "uid": "loki"

    {
      "type": "table",
      "title": "Totaux par utilisateur et source",
      "description": "Agrégat de la plage affichée. `Méthode` doit toujours valoir publickey : un `password` signalerait une régression du durcissement SSH.",
      "datasource": {
        "type": "loki",
        "uid": "loki"

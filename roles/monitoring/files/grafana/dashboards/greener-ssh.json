      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "format": "table",
          "expr": "sum by (user, ip, method) (count_over_time({service=\"ssh\", source=\"journal\"} |= \"Accepted \" | pattern `Accepted <method> for <user> from <ip> port <_>` [$__range]))"

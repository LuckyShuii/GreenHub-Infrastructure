    },
    {
      "type": "stat",
      "title": "Utilisateurs distincts",
      "description": "Comptes ayant ouvert au moins une session sur la plage.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "count (sum by (user) (count_over_time({service=\"ssh\", source=\"journal\"} |= \"Accepted \" | pattern `Accepted <method> for <user> from <ip> port <_>` [$__auto])))",
          "legendFormat": "v"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",

          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum (count_over_time({service=\"ssh\", source=\"journal\"} | level=\"error\" [$__auto]))",
          "legendFormat": "erreur protocole"
        }
      ],
      "options": {

{
  "uid": "greener-edge",
  "title": "GREENER — Bordure",
  "description": "Ce que le monde extérieur reçoit vraiment : codes de réponse et latence vus par Caddy, plus l'état des certificats TLS.",
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "name": "Annotations & Alerts",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "type": "dashboard"
      },
      {
        "name": "Déploiements",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "purple",
        "target": {
          "type": "tags",
          "matchAny": false,
          "tags": [
            "deploy"
          ],
          "limit": 100
        }
      }
    ]
  },
  "tags": [
    "greener",
    "caddy",
    "edge"
  ],
  "timezone": "Europe/Paris",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Trafic servi",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Requêtes (plage affichée)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum (count_over_time({service=\"caddy\"} | json | status != \"\" [$__auto]))",
          "legendFormat": "requêtes"
        }
      ],
      "description": "Compté depuis les logs d'accès de Caddy, pas depuis le backend : c'est ce que le monde extérieur a réellement reçu."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Erreurs 5xx",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum (count_over_time({service=\"caddy\"} | json | status >= 500 [$__auto]))",
          "legendFormat": "5xx"
        }
      ],
      "description": "La règle greener-edge-5xx alerte sur cette même donnée (seuil 10 en 5 min). C'est le seul signal actuel sur la qualité des réponses de l'API."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Erreurs 4xx",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum (count_over_time({service=\"caddy\"} | json | status >= 400 | status < 500 [$__auto]))",
          "legendFormat": "4xx"
        }
      ],
      "description": "Volontairement sans alerte : un crawler qui tape des URL mortes en produit en continu et ce n'est pas une panne."
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Latence médiane",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "quantile_over_time(0.5, {service=\"caddy\"} | json | unwrap duration [$__auto])"
        }
      ],
      "description": "Mesurée par Caddy, donc TLS et réseau inclus — plus proche du vécu utilisateur que n'importe quelle mesure interne."
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Réponses par classe de code",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum (count_over_time({service=\"caddy\"} | json | status < 300 [$__auto]))",
          "legendFormat": "2xx",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        },
        {
          "refId": "B",
          "expr": "sum (count_over_time({service=\"caddy\"} | json | status >= 300 | status < 400 [$__auto]))",
          "legendFormat": "3xx",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        },
        {
          "refId": "C",
          "expr": "sum (count_over_time({service=\"caddy\"} | json | status >= 400 | status < 500 [$__auto]))",
          "legendFormat": "4xx",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        },
        {
          "refId": "D",
          "expr": "sum (count_over_time({service=\"caddy\"} | json | status >= 500 [$__auto]))",
          "legendFormat": "5xx",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "description": "Empilé : la hauteur totale est le trafic, la couleur du haut dit s'il se passe quelque chose."
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Requêtes par domaine",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (request_host) (count_over_time({service=\"caddy\"} | json | status != \"\" [$__auto]))",
          "legendFormat": "{{request_host}}",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "description": "api, greenhub, grafana et deploy passent tous par le même Caddy. Utile pour savoir qui est visé quand le volume grimpe."
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Latence des réponses",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "s",
          "decimals": 3,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.5, {service=\"caddy\"} | json | unwrap duration [$__auto])",
          "legendFormat": "p50",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        },
        {
          "refId": "B",
          "expr": "quantile_over_time(0.95, {service=\"caddy\"} | json | unwrap duration [$__auto])",
          "legendFormat": "p95",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        },
        {
          "refId": "C",
          "expr": "quantile_over_time(0.99, {service=\"caddy\"} | json | unwrap duration [$__auto])",
          "legendFormat": "p99",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "description": "Aucune alerte dessus pour l'instant : il n'y a pas assez de trafic réel pour qu'un seuil veuille dire quelque chose. À reprendre quand l'API sera instrumentée."
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Chemins les plus servis",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (request_uri) (count_over_time({service=\"caddy\"} | json | status != \"\" [$__auto])))",
          "legendFormat": "{{request_uri}}",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "description": "topk(10) et pas tout : une URI est une étiquette à cardinalité libre, un graphe non borné deviendrait illisible et coûteux."
    },
    {
      "id": 10,
      "type": "row",
      "title": "Certificats et disponibilité (sondes)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Jours avant expiration TLS",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 7
              },
              {
                "color": "green",
                "value": 21
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min by (instance) ((probe_ssl_earliest_cert_expiry - time()) / 86400)",
          "legendFormat": "{{instance}}"
        }
      ],
      "description": "Mesuré en allant chercher le certificat réellement servi. greener-tls-expiry-warning alerte sous 21 jours (donc après un renouvellement ACME déjà raté, qui se fait à 30) et greener-tls-expiry-critical sous 7."
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Sondes au vert",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(probe_success)"
        }
      ],
      "description": "Ces sondes partent DU VPS : elles ne savent rien dire quand c'est le VPS qui tombe. C'est UptimeRobot qui couvre ce cas (docs/uptime-externe.md)."
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Latence des sondes",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(probe_duration_seconds)"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Disponibilité vue par les sondes",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "decimals": 0,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "1 = la cible a répondu. greenhub restera à 0 tant que le front n'est pas déployé — c'est attendu, pas une panne."
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Temps de réponse des sondes",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "s",
          "decimals": 3,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_duration_seconds",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 16,
      "type": "row",
      "title": "Ce que Caddy dit (logs)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "panels": []
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Erreurs et avertissements Caddy",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (level) (count_over_time({service=\"caddy\", level=~\"error|warn\"} [$__auto]))",
          "legendFormat": "{{level}}",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "description": "C'est ici qu'un renouvellement ACME en échec se voit, bien avant que le compteur de jours ci-dessus ne devienne inquiétant."
    }
  ]
}

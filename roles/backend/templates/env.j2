# {{ ansible_managed }}
# Rendered by the `backend` role — NEVER edit by hand, changes are overwritten.
# Contract with the apps = these NAMES only; keep in sync with the .env.example of the
# backend repo (DB_*) and of the ai-service repo (AI_*/QDRANT_*). Uses clear-text
# indirection vars (db_password), never vault_*.
# This single file is the env_file of BOTH containers; each app ignores what it does not
# declare (pydantic-settings extra="ignore").

APP_ENV={{ env_name }}

DB_HOST={{ backend_db_host }}
DB_PORT={{ backend_db_port }}
DB_NAME={{ backend_db_name }}
DB_USER={{ backend_db_user }}
DB_PASSWORD={{ db_password }}

# Only the values infra must pin are rendered; the AI service's other knobs
# (IMAGES_PER_LABEL, REQUEST_TIMEOUT, MAX_RETRIES, MAX_CONCURRENT_DOWNLOADS) keep their
# code defaults so there is less to drift.
EMBEDDING_MODEL_NAME={{ ai_embedding_model }}
AI_HOST={{ ai_host }}
AI_PORT={{ ai_port }}
DEVICE={{ ai_device }}
DATA_DIR={{ ai_data_dir }}
SAVE_IMAGES={{ ai_save_images | lower }}
LOG_LEVEL={{ ai_log_level }}

QDRANT_HOST={{ qdrant_host }}
QDRANT_PORT={{ qdrant_port }}
# {{ ansible_managed }}
# Rendered by the `backend` role — NEVER edit by hand, changes are overwritten.
# Contract with the FastAPI app = these NAMES only; keep in sync with the backend
# repo's .env.example. Uses clear-text indirection vars (db_password), never vault_*.

APP_ENV={{ env_name }}

DB_HOST={{ backend_db_host }}
DB_PORT={{ backend_db_port }}
DB_NAME={{ backend_db_name }}
DB_USER={{ backend_db_user }}
DB_PASSWORD={{ db_password }}

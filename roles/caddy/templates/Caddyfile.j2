# Managed by Ansible (caddy role) — do not edit by hand.
{
	# ACME CA. Staging by default (generous rate limits, browser-untrusted certs);
	# prod issues real, trusted certs. Toggled via caddy_acme_staging.
{% if caddy_acme_staging %}
	acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
{% else %}
	acme_ca https://acme-v02.api.letsencrypt.org/directory
{% endif %}
}

# Reusable security headers: HSTS + clickjacking / MIME-sniffing hardening.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		# Don't advertise the server software.
		-Server
	}
}

greenhub.{{ caddy_domain }}, api.{{ caddy_domain }} {
	# HTTP→HTTPS redirect is automatic in Caddy; TLS is provisioned via ACME above.
	import security_headers

{% if caddy_access_log | bool %}
	# One JSON line per response, into stdout — which under systemd IS the journal, which
	# Alloy already ships to Loki. No new component, no new port: this is the cheapest
	# possible answer to "is the API returning errors", a question nothing else in the
	# stack can answer today (container-up says nothing about what it replies).
	#
	# `format json` is PINNED, not left to Caddy's default. Caddy picks console format on a
	# terminal and JSON otherwise, so the default works here by accident — and the
	# greener-edge-5xx rule parses these lines with `| json`, so the day that accident
	# stops holding the rule matches nothing and says nothing about it.
	#
	# COST: one log line per request, on a host whose disk is the tightest constraint.
	# Acceptable at today's traffic; the lever if it stops being so is
	# monitoring_loki_retention, not turning this off.
	log {
		output stdout
		format json
	}
{% endif %}

	# Static privacy policy, served by Caddy itself and never proxied.
	#
	# It exists because Google refuses to move an OAuth app out of "Testing" without a
	# reachable homepage and privacy-policy URL, and an app left in Testing has its refresh
	# token expired every 7 days — which would stop the off-site backup sync dead, silently.
	# Hosting it here rather than on a third party keeps it on a domain we control and
	# renew.
	#
	# Matched on the greenhub host only: api.<domain> belongs to the backend, and shadowing
	# a path there would be a surprise waiting to happen.
	#
	# NO braces anywhere in the body: Caddy reads `{...}` inside a quoted string as a
	# placeholder, so a <style> block would fail to parse.
	@privacy host greenhub.{{ caddy_domain }}
	handle @privacy {
		handle /privacy /privacy/ {
			header Content-Type "text/html; charset=utf-8"
			respond `<!doctype html>
<html lang="fr">
<meta charset="utf-8">
<title>GREENER — Politique de confidentialité</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<body style="max-width:42rem;margin:3rem auto;padding:0 1rem;font-family:system-ui,sans-serif;line-height:1.6">
<h1>Politique de confidentialité</h1>
<p>GREENER est un projet étudiant EPITECH. Cette page décrit l'usage fait de l'accès Google Drive demandé par l'application OAuth « GreenHub Backups ».</p>
<h2>Ce que l'application fait</h2>
<p>Elle téléverse des sauvegardes chiffrées de la base de données du projet vers le Google Drive du compte qui a donné l'autorisation. Elle n'écrit rien d'autre et ne lit aucun autre fichier.</p>
<h2>Portée de l'accès</h2>
<p>L'autorisation demandée est limitée au périmètre <code>drive.file</code> : l'application ne peut voir et gérer que les fichiers qu'elle a elle-même créés. Le reste du Drive lui est inaccessible.</p>
<h2>Données concernées</h2>
<p>Les fichiers téléversés sont des sauvegardes de base de données chiffrées (GPG, AES-256) et illisibles sans une phrase secrète qui n'est jamais transmise à Google. L'application ne collecte aucune donnée personnelle auprès des utilisateurs finaux et n'en transmet aucune à un tiers.</p>
<h2>Conservation</h2>
<p>Les sauvegardes sont supprimées automatiquement au bout de 30 jours.</p>
<h2>Contact</h2>
<p>{{ caddy_privacy_contact }}</p>
</body>
</html>
` 200
		}

		handle {
			reverse_proxy {{ caddy_backend_upstream }}
		}
	}

	# Reverse-proxy to the app container over the internal network. Upstreams are resolved
	# lazily (per request), so a missing/absent backend does NOT stop Caddy from starting
	# or from completing its ACME challenge.
	handle {
		reverse_proxy {{ caddy_backend_upstream }}
	}

	# Fallback: if the backend is down or not deployed yet, return a plain 200 instead of a
	# raw 502 — the site (and its ACME-provisioned cert) still work end-to-end.
	handle_errors {
		respond "GREENER OK" 200
	}
}

{% if caddy_deploy_enabled %}
# CD deploy endpoint: the CI POSTs here after publishing an image. Caddy only terminates
# TLS and forwards — the token is checked by the webhook daemon itself, which answers 403
# and runs nothing when it does not match.
deploy.{{ caddy_domain }} {
	import security_headers

	handle /hooks/* {
		reverse_proxy {{ caddy_deploy_upstream }}
	}

	# No friendly fallback here, unlike the app vhost: a deploy trigger that does not
	# reach the daemon must fail the pipeline rather than look like a success.
	handle {
		respond 404
	}
}
{% endif %}

{% if caddy_grafana_enabled | bool %}
# Grafana, exposed publicly ONLY when grafana_public is on. Caddy terminates TLS and
# forwards to the loopback port the monitoring role publishes; the only authentication is
# Grafana's own admin login, which is why this stays off until the VPN lands (SCRUM-58).
# Needs a DNS record for grafana.{{ caddy_domain }} or ACME cannot issue its certificate.
grafana.{{ caddy_domain }} {
	import security_headers

	reverse_proxy {{ caddy_grafana_upstream }}
}
{% endif %}
